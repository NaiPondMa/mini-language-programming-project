-- 02_recursion.lumi : recursion, pattern matching, tail calls

let rec factorial n = if n == 0 then 1 else n * factorial (n - 1)
print (factorial 5)
print (factorial 20)     -- Python ints never overflow

let rec fib n = match n with
  | 0 -> 0
  | 1 -> 1
  | _ -> fib (n - 1) + fib (n - 2)
print (fib 15)

-- tail recursion with an accumulator (Lumi optimises tail calls)
let rec sumTo n acc = if n == 0 then acc else sumTo (n - 1) (acc + n)
print (sumTo 100000 0)

let rec gcd a b = if b == 0 then a else gcd b (a % b)
print (gcd 48 18)

-- a local helper with  let ... in
let power base exp =
  let rec go e acc = if e == 0 then acc else go (e - 1) (acc * base) in
  go exp 1
print (power 2 10)
