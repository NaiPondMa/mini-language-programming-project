-- 05_logic_lists.lumi : lists and arithmetic in logic programming

-- append works "forwards" and "backwards"
fact append([], L, L).
rule append([H|T], L, [H|R]) :- append(T, L, R).

query append([1, 2], [3, 4], X)?
query append(X, Y, [1, 2, 3])?

fact member(X, [X|_]).
rule member(X, [_|T]) :- member(X, T).
query member(b, [a, b, c])?

-- arithmetic uses 'is'
fact len([], 0).
rule len([_|T], N) :- len(T, M), N is M + 1.
query len([a, b, c, d], N)?

fact factorial(0, 1).
rule factorial(N, F) :- N > 0, N1 is N - 1, factorial(N1, F1), F is N * F1.
query factorial(10, F)?

-- reverse with an accumulator
rule reverse(L, R) :- rev(L, [], R).
fact rev([], Acc, Acc).
rule rev([H|T], Acc, R) :- rev(T, [H|Acc], R).
query reverse([1, 2, 3, 4], R)?
